# ==============================================================
# Kavach Cloud API - Environment Configuration
# ==============================================================

PROJECT_NAME="Kavach Security API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Tiger Data (TimescaleDB) Connection String:
# Grab this from your tigerdata.com console (Service Details -> Connection String)
# Example format: postgresql+asyncpg://tsdbadmin:<PASSWORD>@<HOST>.tigerdata.cloud:5432/tsdb?ssl=require
DATABASE_URL="postgresql+asyncpg://tsdbadmin:YOUR_PASSWORD_HERE@YOUR_HOST.tigerdata.cloud:5432/tsdb?ssl=require"

# Fallback for offline local testing without Tiger Data (uncomment to use SQLite):
# DATABASE_URL="sqlite+aiosqlite:///./kavach_dev.db"

# JWT Security
JWT_SECRET="kavach_super_secret_jwt_key_hackathon_demo_2026_xyz"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (Allow all for hackathon / local dev)
ALLOWED_ORIGINS=["*"]

# Google Gemini API Key (Grab free key from https://aistudio.google.com/)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-1.5-flash"

